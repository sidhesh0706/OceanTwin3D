# Optional; set these in your shell or PyCharm run configuration.
# run.py does not automatically load this file.
# OCEANTWIN_DATASET=C:/ocean-data/regional-model.nc
# OCEANTWIN_OBSERVATIONS=C:/ocean-data/observations.json
# Optional Cesium ion token for the cinematic landing (photorealistic 3D
# tiles + bathymetry) and explorer satellite imagery. Without it both
# views use bundled Natural Earth imagery. Set in frontend/.env.local
# before building; Vite exposes this token to the browser. Use a
# restricted public token appropriate for your host. Frontend name:
# VITE_CESIUM_ION_TOKEN=your-ion-token
